# Telegram Bot Configurations
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of authorized Telegram chat IDs (e.g. 123456789,987654321)
TELEGRAM_CHAT_IDS=your_chat_id_here

# Google Gemini API configurations
GEMINI_API_KEY=your_gemini_api_key_here
# Comma-separated fallback chain, tried left to right
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# Scanner Configurations
POLL_INTERVAL_MINUTES=5
DRY_RUN=false
# Max articles sent to the AI per run, so a backlog cannot drain the daily quota at once
MAX_ARTICLES_PER_RUN=40

# Optional database filename
DB_PATH=db.json

# Chống dồn tin: tối đa bao nhiêu tin được gửi trong một chu kỳ, và cách nhau bao lâu.
# Phần còn lại để dành cho run sau thay vì bắn hết một lượt.
MAX_SENDS_PER_RUN=3
SEND_SPACING_SECONDS=60

# Chat ID nhận cảnh báo lỗi. Không có thì cảnh báo chỉ nằm trong log,
# tuyệt đối không rơi vào kênh tin hay danh sách subscriber.
TELEGRAM_ALERT_CHAT_ID=
